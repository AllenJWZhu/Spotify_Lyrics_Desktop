{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrics Overlay",
  "identifier": "io.github.allenjwzhu.lyrics-overlay",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Lyrics Overlay",
        "width": 960,
        "height": 176,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Allen Zhu",
    "copyright": "Copyright © 2026 Allen Zhu. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/AllenJWZhu/Spotify_Lyrics_Desktop",
    "category": "Music",
    "shortDescription": "Floating desktop lyrics for the Spotify desktop app",
    "longDescription": "A transparent, always-on-top lyrics window for the Spotify desktop app on Windows. Reads playback from the Windows media controls (no Spotify login) and synced lyrics from LRCLIB. Not affiliated with Spotify.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
