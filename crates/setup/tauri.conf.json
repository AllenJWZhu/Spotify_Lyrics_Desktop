{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrics Overlay Setup",
  "identifier": "io.github.allenjwzhu.lyrics-overlay.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "setup",
        "title": "Lyrics Overlay Setup",
        "width": 560,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#1b1d4a",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../app/icons/32x32.png",
      "../app/icons/128x128.png",
      "../app/icons/icon.png",
      "../app/icons/icon.ico"
    ]
  }
}
